    "Merajfy answered with error %lld.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Merajfy با خطای %lld پاسخ داد."
          }
        }
      }
    },
    "Merajfy could not get that song.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Merajfy نتوانست این آهنگ را بگیرد."
          }
        }
      }
    },
    "Merajfy could not hand over the file.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Merajfy نتوانست فایل را تحویل دهد."
          }
        }
      }
    },
    "Merajfy is a separate program that runs on your Mac. With this on, a Spotify track, album or playlist link in Add from Link is downloaded and added to your library. With it off, those links are only added to your Wishlist by name. On the Mac the address is 127.0.0.1:8787; on the iPhone use your Mac's address and the token shown in Merajfy's settings.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Merajfy برنامه‌ای جداست که روی مک شما اجرا می‌شود. وقتی روشن باشد، لینک آهنگ، آلبوم یا پلی‌لیست اسپاتیفای در «افزودن از لینک» دانلود و به کتابخانه اضافه می‌شود. وقتی خاموش باشد، این لینک‌ها فقط با نام به فهرست آرزوها می‌روند. روی مک نشانی 127.0.0.1:8787 است؛ روی آیفون نشانی مک و توکنی را که در تنظیمات Merajfy نمایش داده می‌شود بنویسید."
          }
        }
      }
    },
    "Merajfy is not set up. Turn it on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Merajfy تنظیم نشده است. آن را در تنظیمات روشن کنید."
          }
        }
      }
    },
    "Merajfy is ready on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Merajfy روی همین iPhone آماده است."
          }
        }
      }
    },
    "Merajfy is ready.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Merajfy آماده است."
          }
        }
      }
    },
    "Merajfy is running but yt-dlp or ffmpeg is missing on the Mac.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Merajfy روشن است ولی yt-dlp یا ffmpeg روی مک نیست."
          }
        }
      }
    },
