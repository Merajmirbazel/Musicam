    "Telegram": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلگرام"
          }
        }
      }
    },
    "Telegram Desktop usually saves files in a folder called “Telegram Desktop” inside Downloads. Watch that folder and every audio file you receive shows up in Musicam, then on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلگرام دسکتاپ معمولاً فایل‌ها را در پوشه‌ای به نام «Telegram Desktop» داخل Downloads ذخیره می‌کند. آن پوشه را تحت نظر بگیرید تا هر فایل صوتی که دریافت می‌کنید در Musicam و بعد روی آیفون‌تان ظاهر شود."
          }
        }
      }
    },
    "Test Connection": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آزمایش اتصال"
          }
        }
      }
    },
    "That QR code is not a Musicam pairing code.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کد QR، کد جفت‌سازی Musicam نیست."
          }
        }
      }
    },
    "That address does not look like Merajfy.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نشانی شبیه Merajfy نیست."
          }
        }
      }
    },
    "That code is not valid. It should be 64 letters and digits, shown in groups of 8.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کد معتبر نیست. باید ۶۴ حرف و رقم باشد که در گروه‌های ۸تایی نوشته می‌شود."
          }
        }
      }
    },
    "That does not look like a link to a song or an audio file.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این شبیه لینک یک آهنگ یا فایل صوتی نیست."
          }
        }
      }
    },
    "That file could not be added.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل اضافه نشد."
          }
        }
      }
    },
    "That file is too large.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل خیلی بزرگ است."
          }
        }
      }
    },
    "That is not an Internet Archive link.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این لینک Internet Archive نیست."
          }
        }
      }
    },
    "That link has no songs.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این لینک آهنگی ندارد."
          }
        }
      }
    },
    "That link is already on your Wishlist.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این لینک از قبل در فهرست آرزوها هست."
          }
        }
      }
    },
    "That link is not a direct audio file.": {
      "extractionState": "manual",
      "localizations": {
