    "Touch and hold a song in Library and choose Add to Playlist.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در کتابخانه روی آهنگ نگه دارید و «افزودن به پلی‌لیست» را بزنید."
          }
        }
      }
    },
    "Treat this code like a password: anyone who has it can sync with your library while on your network.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این کد مثل رمز عبور رفتار کنید: هر کسی که آن را داشته باشد و در شبکهٔ شما باشد می‌تواند با کتابخانه‌تان همگام شود."
          }
        }
      }
    },
    "Try Again": {
