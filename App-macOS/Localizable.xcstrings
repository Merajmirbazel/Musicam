    "Songs and changes appear on both. A song's audio file is copied to a device the first time you play it there.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهنگ‌ها و تغییرها روی هر دو دیده می‌شوند. فایل صوتی یک آهنگ اولین بار که آن را روی یک دستگاه پخش کنید روی آن کپی می‌شود."
          }
        }
      }
    },
    "Songs copied from your other device, downloaded from a link, or received from Telegram or another app show up here.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهنگ‌هایی که از دستگاه دیگر کپی شده، از لینک دانلود شده یا از تلگرام و برنامه‌های دیگر رسیده‌اند اینجا نشان داده می‌شوند."
          }
        }
      }
    },
    "Songs you have played the least show up here.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهنگ‌هایی که کمتر از همه پخش کرده‌اید اینجا نشان داده می‌شوند."
          }
        }
      }
    },
    "Songs you play show up here.": {
      "extractionState": "manual",
