    "Link copied. Open Musicam and choose Add from Link.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لینک کپی شد. Musicam را باز کنید و «افزودن از لینک» را بزنید."
          }
